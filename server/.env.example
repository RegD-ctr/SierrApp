# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sierra_app?schema=public"

# Puerto y entorno del servidor
PORT=4000
NODE_ENV="development"

# Secretos JWT (generar valores aleatorios de al menos 64 caracteres en producción)
JWT_ACCESS_SECRET="change_me_access_secret_min_32_chars"
JWT_REFRESH_SECRET="change_me_refresh_secret_min_32_chars"

# Origen permitido por CORS en producción
CORS_ORIGIN="http://localhost:8443"

# Credenciales iniciales del administrador para el seed
ADMIN_SEED_EMAIL="admin@sierra.com"
ADMIN_SEED_PASSWORD="ChangeMeAdmin123!"

